# Solo para correr la app EN LOCAL. En Railway estas variables se cargan en
# el panel del servicio (Variables), nunca en el repo.

# Clave para firmar las sesiones. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Anthropic (IA que extrae la marca y prioriza): https://console.anthropic.com
ANTHROPIC_API_KEY=
# IA_MODEL=claude-opus-5

# Base de datos. Vacio = SQLite local en ./data/crm.db
# En Railway la pone sola el servicio de Postgres (DATABASE_URL).
# DATABASE_URL=

# 0 = no correr el trabajo de fondo (busquedas e IA). Solo para pruebas.
# TRABAJOS=1
